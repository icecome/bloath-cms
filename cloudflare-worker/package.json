{
  "name": "bloath-cms-worker",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build-assets && wrangler deploy",
    "build-assets": "cd ../web && npm run build && node -e \"const fs=require('fs');const d='../cloudflare-worker/public';if(fs.existsSync(d))fs.rmSync(d,{recursive:true});fs.cpSync('dist',d,{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "db:migrate:local": "wrangler d1 migrations apply bloath-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bloath-db --remote"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.7.0",
    "wrangler": "^4.152.0"
  }
}
