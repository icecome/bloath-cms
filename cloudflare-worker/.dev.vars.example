# Cloudflare Worker 环境变量示例
# 复制为 .dev.vars 并修改

# GitHub OAuth 应用配置
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session 加密密钥（至少 32 字符随机字符串）
SESSION_SECRET=

# 前端地址（OAuth 回调用）
FRONTEND_URL=http://localhost:5173

# 允许的 CORS 来源（逗号分隔，可选，默认包含 localhost）
ALLOWED_ORIGINS=

# 生产环境域名（逗号分隔，可选）
PROD_ORIGINS=https://your-domain.com

# 内容安全策略（可选，默认已提供宽松适配的默认值）
# 如需自定义可覆盖，示例：default-src 'self'; script-src 'self'; ...
CONTENT_SECURITY_POLICY=

# KV 设备名单命名空间 ID：填入你自己的 Cloudflare KV Namespace ID（形如 24 位十六进制）。
# 作用：部署脚本 scripts/fill-kv-namespace.mjs 会用此 ID 生成 wrangler.deploy.jsonc，从而把
#   DEVICES_KV 绑定写进代码部署（CI 推送不会被清空绑定）。
# 获取方式：Dashboard → Workers → KV → 新建 Namespace 后复制 ID。
# 注意：CI 部署读取的是 GitHub Secret KV_NAMESPACE_ID，这里仅用于本地 dev。
KV_NAMESPACE_ID=
