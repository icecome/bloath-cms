# Cloudflare Worker 环境变量示例
# 复制为 .dev.vars 并修改

# GitHub OAuth 应用配置
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session 加密密钥（至少 32 字符随机字符串）
SESSION_SECRET=

# 前端地址（OAuth 回调用）
FRONTEND_URL=http://localhost:5173

# 允许的 CORS 来源（逗号分隔，可选，默认包含 localhost）
ALLOWED_ORIGINS=

# 生产环境域名（逗号分隔，可选）
PROD_ORIGINS=https://your-domain.com

# 内容安全策略（可选，默认已提供宽松适配的默认值）
# 如需自定义可覆盖，示例：default-src 'self'; script-src 'self'; ...
CONTENT_SECURITY_POLICY=

# KV 设备名单命名空间 ID（本地 dev 用 miniflare 模拟时可不填；deploy 由 wrangler.jsonc 的
# ${KV_NAMESPACE_ID} 引用，CI 通过 GitHub Secret KV_NAMESPACE_ID 注入；本地如需连真实 KV 可填写）
# 在 Cloudflare Dashboard: Workers → KV → 新建 Namespace，取其 ID 填入
KV_NAMESPACE_ID=
