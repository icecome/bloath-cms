{
  "$schema": "https://workers.cloudflare.com/ns/type",
  "name": "bloath-cms-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-15",
  "observability": {
    "enabled": true
  },
  "placement": {
    // Cloudflare 自动将 Worker 调度到离上游服务（GitHub API）延迟最低的节点。
    // 对中国用户访问站点影响极小；对 Worker→GitHub 的请求链路可节省 ~800ms/次往返。
    // 首次部署后最多需 15 分钟完成学习期。可通过 cf-placement 响应头确认生效状态。
    "mode": "smart"
  },
  "kv_namespaces": [
    {
      "binding": "DEVICES_KV",
      "id": "${KV_NAMESPACE_ID}"
    },
    {
      "binding": "CACHE_KV",
      "id": "${CACHE_KV_NAMESPACE_ID}"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bloath-db",
      "database_id": "a6379ed3-b052-440a-bb83-98bbad218077",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ORIGIN": "https://bloath.icecome.com"
  }
}
